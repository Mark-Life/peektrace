#!/bin/sh
# Format only what is staged, then re-stage it.
set -ef

staged() { git diff --cached --name-only --diff-filter=ACMR -z -- "$@"; }
has_staged() { [ -n "$(staged "$@" | tr -d '\0')" ]; }

JS='*.ts *.tsx *.js *.jsx *.json *.jsonc *.css *.yml *.yaml'

# shellcheck disable=SC2086
if has_staged $JS; then
  staged $JS | xargs -0 bun x ultracite fix
  staged $JS | xargs -0 git add --
fi

if has_staged '*.rs'; then
  cargo fmt --all
  staged '*.rs' | xargs -0 git add --
fi
